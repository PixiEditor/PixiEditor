<dialogs:PixiEditorPopup
    x:Class="PixiEditor.Views.Dialogs.NewFilePopup"
    x:ClassModifier="internal"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:PixiEditor.UI.Common.Localization;assembly=PixiEditor.UI.Common"
    xmlns:dialogs="clr-namespace:PixiEditor.Views.Dialogs"
    xmlns:input="clr-namespace:PixiEditor.Views.Input"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:changeables="clr-namespace:PixiEditor.ChangeableDocument.Changeables;assembly=PixiEditor.ChangeableDocument"
    xmlns:controls="clr-namespace:PixiEditor.UI.Common.Controls;assembly=PixiEditor.UI.Common"
    Width="320" Height="250"
    SizeToContent="Height"
    CanResize="False"
    CanMinimize="False"
    Name="popup"
    ui:Translator.Key="CREATE_NEW_IMAGE">
    <StackPanel Focusable="True" Orientation="Vertical"
                Margin="15,15,15,0">
        <Separator Margin="10,15,10,0" Height="0" />
        <Border HorizontalAlignment="Center" Background="{DynamicResource ThemeBackgroundBrush1}"
                VerticalAlignment="Top" CornerRadius="{DynamicResource ControlCornerRadius}"
                Margin="0" Padding="0">
            <StackPanel>
                <ComboBox ItemsSource="{Binding Presets, ElementName=popup}"
                          SelectedItem="{Binding SelectedPreset, ElementName=popup}"
                          PlaceholderText="{ui:Translate Key=PRESETS}"
                          Margin="15,15,15,0"
                          VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="dialogs:SizePreset">
                            <TextBlock ui:Translator.Key="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Spacing="5" Margin="15, 15, 15, 0">
                    <TextBlock ui:Translator.Key="MEASUREMENT_UNIT"/>
                    <ComboBox ItemsSource="{Binding ElementName=popup, Path=Units}" Width="90"
                              SelectedValue="{Binding ElementName=popup, Path=SelectedMeasurementUnit}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="changeables:MeasurementUnit">
                                <TextBlock ui:Translator.Key="{Binding LongNameLocalizationKey}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock ui:Translator.Key="DPI"/>
                    <controls:NumberInput Decimals="2" Width="50" Min="0.01" Value="{Binding ElementName=popup, Path=Dpi, Mode=TwoWay}" />

                </StackPanel>
                <input:SizePicker HorizontalAlignment="Center" MinWidth="230" Height="125" Margin="0"
                                  PreserveAspectRatio="False"
                                  FixedInputSize="100"
                                  Background="{DynamicResource ThemeBackgroundBrush1}"
                                  CornerRadius="{DynamicResource ControlCornerRadius}"
                                  ChosenHeight="{Binding FileHeight, Mode=TwoWay, ElementName=popup}"
                                  ChosenWidth="{Binding FileWidth, Mode=TwoWay, ElementName=popup}"
                                  InputUnit="{Binding ElementName=popup, Path=SelectedMeasurementUnit.ShortNameLocalizationKey}"
                                  MeasurementUnitConverter="{Binding ElementName=popup, Path=SelectedMeasurementConverterData}"
                                  x:Name="sizePicker" />
            </StackPanel>
        </Border>
        <Button DockPanel.Dock="Bottom" Margin="0,15,0,15" HorizontalAlignment="Center"
                IsDefault="True" ui:Translator.Key="CREATE" x:Name="createButton" Focusable="True"
                Command="{ReflectionBinding Path=DataContext.SetResultAndCloseCommand, ElementName=popup}">
            <Button.CommandParameter>
                <system:Boolean>True</system:Boolean>
            </Button.CommandParameter>
        </Button>
    </StackPanel>
</dialogs:PixiEditorPopup>