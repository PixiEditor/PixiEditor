<dialogs:PixiEditorPopup xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:dialogs="clr-namespace:PixiEditor.Views.Dialogs"
                         xmlns:layers="clr-namespace:PixiEditor.ViewModels.Layers"
                         xmlns:localization="clr-namespace:PixiEditor.UI.Common.Localization;assembly=PixiEditor.UI.Common"
                         xmlns:nodes="clr-namespace:PixiEditor.ViewModels.Nodes"
                         xmlns:behaviours="clr-namespace:PixiEditor.Helpers.Behaviours"
                         mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                         x:Class="PixiEditor.Views.Dialogs.FiltersPopup"
                         x:DataType="layers:FiltersPopupViewModel"
                         Width="600"
                         Height="400"
                         localization:Translator.Key="FILTERS_WINDOW_TITLE">
    <Design.DataContext>
        <layers:FiltersPopupViewModel />
    </Design.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>200,*</Grid.ColumnDefinitions>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="+">
                    <Button.Flyout>
                        <MenuFlyout ItemsSource="{Binding AvailableFilters}">
                            <MenuFlyout.ItemContainerTheme>
                                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Command"
                                            Value="{Binding $parent[dialogs:FiltersPopup].((layers:FiltersPopupViewModel)DataContext).AddFilterCommand}" />
                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                </ControlTheme>
                            </MenuFlyout.ItemContainerTheme>
                            <MenuFlyout.ItemTemplate>
                                <DataTemplate DataType="layers:FilterMetadata">
                                    <TextBlock Classes="pixi-icon">
                                        <Run Text="{Binding Icon}" />
                                        <Run localization:Translator.Key="{Binding Name}" />
                                    </TextBlock>
                                </DataTemplate>
                            </MenuFlyout.ItemTemplate>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Classes="pixi-icon"
                        Content="{DynamicResource icon-trash}"
                        Command="{Binding RemoveFilterCommand}" />
            </StackPanel>
            <ListBox ItemsSource="{Binding LayerFilters}"
                     SelectedItem="{Binding SelectedFilter, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="nodes:NodeViewModel">
                        <Grid>
                            <Border Background="Transparent">
                                <Grid ColumnDefinitions="24,*">
                                    <TextBlock Grid.Column="0"
                                               Text=""
                                               LetterSpacing="-8"
                                               Margin="-5, 0, 0, 0"
                                               ClipToBounds="False"
                                               Opacity="0.5"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Cursor="SizeAll"
                                               Classes="pixi-icon reorder-handle" />
                                    <TextBlock Grid.Column="1"
                                               Classes="pixi-icon"
                                               VerticalAlignment="Center">
                                        <Run Text="{Binding Icon}" />
                                        <Run localization:Translator.Key="{Binding DisplayName}" />
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <Interaction.Behaviors>
                    <behaviours:ListBoxReorderBehavior x:TypeArguments="nodes:NodeViewModel"></behaviours:ListBoxReorderBehavior>
                </Interaction.Behaviors>
            </ListBox>
        </StackPanel>
        <Panel Grid.Column="1" ClipToBounds="True">
            <ItemsControl ItemsSource="{Binding SelectedFilter.Inputs}" Margin="5" Padding="-10, 0, 0, 0">

            </ItemsControl>
        </Panel>
    </Grid>
</dialogs:PixiEditorPopup>